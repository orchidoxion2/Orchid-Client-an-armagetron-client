<?xml version="1.0" encoding="ISO-8859-1" standalone="no"?>
<!DOCTYPE Resource SYSTEM "cockpit.dtd">

<!-- Orchi Tron HUD: score and round on top, speed, rubber and brake below, map in the corner.
     Coordinates go from -1 to 1 in both directions; laid out for 16:9 screens. -->
<Resource type="aacockpit" name="standard" version="0.0.1" author="Anonymous" category="">
    <Cockpit version="0.0.1" coordinates="screen">

        <!-- score box, top center -->
        <Rectangle camera="all">
            <Position x="0" y="0.931" />
            <Size width="0.093" height="0.048" />
            <Background><Solid><Color r=".13" g=".15" b=".18" alpha=".9" /></Solid></Background>
        </Rectangle>
        <Rectangle camera="all">
            <Position x="0" y="0.931" />
            <Size width="0.091" height="0.044" />
            <Background><Solid><Color r=".04" g=".05" b=".06" alpha=".85" /></Solid></Background>
        </Rectangle>
        <Label camera="all">
            <DataSet id="me">
                <AtomicData source="current_score_colored" />
            </DataSet>
            <DataSet id="other">
                <AtomicData source="top_other_score_colored" />
            </DataSet>
            <Position x="0" y="0.972" />
            <Size height="0.058" width="0.018" />
            <Align value="center" />
            <Caption location="off"><Text value="Score" /></Caption>
            <Face>
                <Table>
                    <Row>
                        <Cell><GameData data="me" /></Cell>
                        <Cell><Text value="0x8c8c96:" /></Cell>
                        <Cell><GameData data="other" /></Cell>
                    </Row>
                </Table>
            </Face>
        </Label>
        <Label camera="all">
            <DataSet id="round">
                <AtomicData source="round_text" />
            </DataSet>
            <Position x="0" y="0.858" />
            <Size height="0.036" width="0.01" />
            <Align value="center" />
            <Caption location="off"><Text value="Round" /></Caption>
            <Face>
                <Table>
                    <Row>
                        <Cell><Text value="0x8c8c96" /><GameData data="round" /></Cell>
                    </Row>
                </Table>
            </Face>
        </Label>

        <!-- frame rate and ping, top right -->
        <Label camera="all">
            <DataSet id="fps">
                <AtomicData source="current_framerate" />
            </DataSet>
            <DataSet id="ping">
                <AtomicData source="current_ping" />
            </DataSet>
            <Position x="0.965" y="0.957" />
            <Size height="0.036" width="0.01" />
            <Align value="right" />
            <Caption location="off"><Text value="Status" /></Caption>
            <Face>
                <Table>
                    <Row>
                        <Cell><Text value="0x8c8c96" /><GameData data="fps" /><Text value=" FPS  -  " /><GameData data="ping" /><Text value=" MS" /></Cell>
                    </Row>
                </Table>
            </Face>
        </Label>

        <!-- speed, bottom center -->
        <Label camera="all">
            <DataSet id="speed">
                <AtomicData source="player_speed" precision="0" />
            </DataSet>
            <Position x="0" y="-0.735" />
            <Size height="0.125" width="0.01" />
            <Align value="center" />
            <Caption location="off"><Text value="Speed" /></Caption>
            <Face>
                <Table>
                    <Row>
                        <Cell><Text value="0xffffff" /><GameData data="speed" /></Cell>
                    </Row>
                </Table>
            </Face>
        </Label>
        <Label camera="all">
            <Position x="0" y="-0.9" />
            <Size height="0.038" width="0.01" />
            <Align value="center" />
            <Caption location="off"><Text value="Speed caption" /></Caption>
            <Face>
                <Table>
                    <Row>
                        <Cell><Text value="0x8c8c96SPEED" /></Cell>
                    </Row>
                </Table>
            </Face>
        </Label>

        <!-- rubber, left of the speed -->
        <Label camera="all">
            <DataSet id="rubber">
                <AtomicData source="player_rubber" precision="1" />
            </DataSet>
            <Position x="-0.1" y="-0.79" />
            <Size height="0.05" width="0.02" />
            <Align value="right" />
            <Caption location="off"><Text value="Rubber" /></Caption>
            <Face>
                <Table>
                    <Row>
                        <Cell><Text value="0x8c8c96RUBBER" /></Cell>
                        <Cell><Text value="0xffffff" /><GameData data="rubber" /></Cell>
                    </Row>
                </Table>
            </Face>
        </Label>
        <BarGauge camera="all">
            <DataSet>
                <AtomicData field="source" source="player_rubber" />
                <AtomicData field="minimum" source="0" />
                <AtomicData field="maximum" source="cycle_rubber" />
            </DataSet>
            <Position x="-0.235" y="-0.875" />
            <Size width="0.135" height="0.009" />
            <ShowCurrent value="false" />
            <ShowMaximum value="false" />
            <ShowMinimum value="false" />
            <Caption location="off"><Text value="" /></Caption>
            <Background><Solid><Color r=".22" g=".23" b=".26" alpha=".9" /></Solid></Background>
            <Foreground><Solid><Color r=".94" g=".63" b=".19" alpha="1" /></Solid></Foreground>
            <LineColor><Solid><Color r="0" g="0" b="0" alpha="0" /></Solid></LineColor>
        </BarGauge>

        <!-- brake, right of the speed -->
        <Label camera="all">
            <DataSet id="brake">
                <AtomicData source="player_brakes" precision="1" />
            </DataSet>
            <Position x="0.1" y="-0.79" />
            <Size height="0.05" width="0.02" />
            <Caption location="off"><Text value="Brake" /></Caption>
            <Face>
                <Table>
                    <Row>
                        <Cell><Text value="0xffffff" /><GameData data="brake" /></Cell>
                        <Cell><Text value="0x8c8c96BRAKE" /></Cell>
                    </Row>
                </Table>
            </Face>
        </Label>
        <BarGauge camera="all">
            <DataSet>
                <AtomicData field="source" source="player_brakes" />
                <AtomicData field="minimum" source="0" />
                <AtomicData field="maximum" source="1" />
            </DataSet>
            <Position x="0.235" y="-0.875" />
            <Size width="0.135" height="0.009" />
            <ShowCurrent value="false" />
            <ShowMaximum value="false" />
            <ShowMinimum value="false" />
            <Caption location="off"><Text value="" /></Caption>
            <Background><Solid><Color r=".22" g=".23" b=".26" alpha=".9" /></Solid></Background>
            <Foreground><Solid><Color r=".18" g=".82" b=".54" alpha="1" /></Solid></Foreground>
            <LineColor><Solid><Color r="0" g="0" b="0" alpha="0" /></Solid></LineColor>
        </BarGauge>

        <!-- map, bottom right; 1 switches map modes -->
        <Rectangle camera="all">
            <Position x="0.833" y="-0.704" />
            <Size width="0.133" height="0.237" />
            <Background><Solid><Color r=".13" g=".15" b=".18" alpha=".9" /></Solid></Background>
        </Rectangle>
        <Map camera="all">
            <Position x="0.833" y="-0.704" />
            <Size width="0.131" height="0.233" />
            <Background><Solid><Color r=".04" g=".05" b=".06" alpha=".85" /></Solid></Background>
            <MapModes toggleKey="1">
                <MapMode mode="full" rotation="spawn" />
                <MapMode mode="closestZone" rotation="spawn" />
                <MapMode mode="cycle" rotation="camera" zoomFactor="3" clipMode="ellipse" />
                <MapMode mode="cycle" rotation="cycle" zoomFactor="3" />
                <MapMode mode="cycle" rotation="spawn" zoomFactor="4" />
                <MapMode mode="full" rotation="fixed" />
            </MapModes>
        </Map>

    </Cockpit>
</Resource>
